# Confidential Document Analysis Pipeline - environment configuration
#
# Copy this file to .env and fill in real values. .env is gitignored and is
# loaded automatically at startup (via python-dotenv) if present.
#
# None of the values below are real secrets - they are placeholders only.

# -----------------------------------------------------------------------
# Demo mode (no Azure credentials needed)
# -----------------------------------------------------------------------
# When set to 1, every Azure OpenAI call is replaced by a deterministic
# local stub (core/demo_stub.py) that returns schema-valid analysis output
# derived from genuine sentences in the input document - no network call,
# no credentials required. Lets anyone clone this repo and try the full
# pipeline (upload -> extraction -> segmentation -> redaction -> analysis
# -> evidence map -> citation verification) end-to-end with the bundled
# samples/ PDFs. Clearly labelled in the UI whenever active; never falls
# back to this automatically just because credentials are missing - it
# must be turned on explicitly. Leave at 0 (or unset) for real analysis
# once AZURE_OPENAI_* below is configured.
DOCPIPE_DEMO_MODE=0

# -----------------------------------------------------------------------
# Azure OpenAI (required unless DOCPIPE_DEMO_MODE=1)
# -----------------------------------------------------------------------
# Endpoint of your Azure OpenAI resource. Use an EU-region endpoint if you
# need data processing to stay within the EU; this is a deployment choice,
# not something the code enforces.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
# Name of the chat-completion model deployment used for document analysis.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# API version string for the Azure OpenAI REST API.
AZURE_OPENAI_API_VERSION=2024-02-01
# Optional: a separate (cheaper/faster) deployment used only for the initial
# document-type classification step. Falls back to AZURE_OPENAI_DEPLOYMENT
# if left empty.
AZURE_OPENAI_CLASSIFIER_DEPLOYMENT=

# -----------------------------------------------------------------------
# Azure Document Intelligence / OCR (optional - only needed for scanned PDFs)
# -----------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-doc-intelligence-key
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2023-07-31

# -----------------------------------------------------------------------
# LLM input/output token budgets
# -----------------------------------------------------------------------
# Maximum input characters sent to the model per call (0 = no limit).
DOCPIPE_INPUT_MAX_CHARS=0
# Chunking: max characters per chunk, and max output tokens per chunk call.
DOCPIPE_CHUNK_MAX_CHARS=12000
DOCPIPE_CHUNK_MAX_OUTPUT_TOKENS=1200
# Output token budgets per task type.
DOCPIPE_MAX_OUTPUT_TOKENS=2200
DOCPIPE_STRUCT_MAX_OUTPUT_TOKENS=2200
DOCPIPE_DOC_ANALYSIS_MAX_OUTPUT_TOKENS=2400
DOCPIPE_VERIFY_MAX_OUTPUT_TOKENS=1800
DOCPIPE_AKTENVERMERK_MAX_TOKENS=2200

# -----------------------------------------------------------------------
# Classification
# -----------------------------------------------------------------------
# Number of characters from the start of the document used for the fast
# initial document-type classification pass.
DOCPIPE_CLASSIFY_PREVIEW_CHARS=1200

# -----------------------------------------------------------------------
# PDF extraction / OCR polling
# -----------------------------------------------------------------------
# Below this many extracted characters, a PDF is treated as scanned/image-only
# and routed to OCR instead of direct text extraction.
DOCPIPE_MIN_PDF_TEXT_CHARS=120
DOCPIPE_OCR_MAX_POLLS=40
DOCPIPE_OCR_POLL_SLEEP_SEC=1.0

# -----------------------------------------------------------------------
# Segmenter (splits a multi-document PDF into individual documents)
# -----------------------------------------------------------------------
DOCPIPE_SEGMENT_MAX_SEGMENTS=25
DOCPIPE_SEGMENT_MAX_WORKERS=2
DOCPIPE_SEGMENT_BOUNDARY_THRESHOLD=2.4
DOCPIPE_SEGMENT_ADAPTIVE_THRESHOLD=1
DOCPIPE_SEGMENT_BOUNDARY_COOLDOWN_PAGES=1
# Verbose segmenter debug logging (0/1).
DOCPIPE_SEGMENT_DEBUG=0

# -----------------------------------------------------------------------
# Evidence / repeated-edge-line detection (running headers/footers)
# -----------------------------------------------------------------------
DOCPIPE_REPEAT_EDGE_LINES=4
DOCPIPE_REPEAT_EDGE_MIN_PAGES=3
DOCPIPE_REPEAT_EDGE_MIN_RATIO=0.5

# -----------------------------------------------------------------------
# Async segment analysis (concurrency limit)
# Recommendation depends on the Azure OpenAI tier:
#   S0 (free/dev): 1-2    S1 (production): 3-5
# -----------------------------------------------------------------------
DOCPIPE_MAX_CONCURRENT_SEGMENTS=3

# -----------------------------------------------------------------------
# Document cache
# Skips a repeat analysis when the same document is uploaded again. The cache
# is keyed by the document's SHA-256, but the value it stores is the full
# analysis result - extracted values and verbatim quotes included - written to
# doc_cache.sqlite on disk. This is the only component that puts analysis
# output on disk, so it is off by default: enabling it trades confidentiality
# for speed. Leave at 0 unless that trade is acceptable for your deployment.
# -----------------------------------------------------------------------
DOCPIPE_DOC_CACHE_ENABLED=0
DOCPIPE_DOC_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------
# Allow rendering unredacted document text in the UI preview (default off).
ALLOW_PLAINTEXT_PREVIEW=0
# Enable fuzzy text matching for citation/evidence verification.
ENABLE_FUZZY=0
# Verify every cited quote against the source text (fuzzy substring match).
# Deliberately left COMMENTED OUT, because the default is context-dependent:
#   - normal operation:      off, unless you set it to 1 here
#   - DOCPIPE_DEMO_MODE=1:   on, so the demo shows real verification numbers
# Uncommenting either value pins it explicitly and wins in both contexts.
#DOCPIPE_CITATION_VERIFY=0
# Verbose debug logging for deadline extraction.
DOCPIPE_DEBUG_DEADLINES=0

# -----------------------------------------------------------------------
# General
# -----------------------------------------------------------------------
DEBUG=0
LOG_LEVEL=INFO
# console (human-readable) or json (structured, e.g. for log aggregation).
LOG_FORMAT=console
# Port for the standalone health-check endpoint (health.py).
HEALTH_PORT=8502
